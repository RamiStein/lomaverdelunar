# ==========================================
# CONFIGURACIÓN DE ENTORNO - LOMA VERDE LUNAR
# ==========================================

# Puerto del servidor local (opcional, default 3001)
PORT=3001

# Clave maestra de administración CRM (opcional, default lomaverde)
ADMIN_KEY=lomaverde

# ==========================================
# CREDENCIALES DE FIREBASE (GOOGLE CLOUD FIRESTORE)
# ==========================================
# Opción 1: String JSON completo de la clave de cuenta de servicio (Recomendado para Vercel)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Opción 2: Variables individuales
# FIREBASE_PROJECT_ID=loma-verde-lunar-xxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@loma-verde-lunar-xxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# Opción 3: Ruta local al archivo JSON descargado de Firebase
# GOOGLE_APPLICATION_CREDENTIALS=./server/data/serviceAccountKey.json
